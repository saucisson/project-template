# Project template - example environment file.
# Copy to `.env` and fill in: `.env` is git-ignored, never commit secrets.

# Discord incoming webhook for agent-to-owner notifications (ADR-0006).
# Leave empty to fall back to console delivery (urgent notifications then raise).
DISCORD_WEBHOOK_URL=

# Log rendering: console (local) or json (production) - ADR-0003.
LOG_FORMAT=console

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL - ADR-0003.
LOG_LEVEL=INFO

# GitHub token for the local reviewer and merge driver (ADR-0006/0005):
# a fine-grained PAT with pull requests (read/write) and repository
# contents (read/write). Used by `make review` and `make merge-pr`.
GITHUB_TOKEN=

# Reviewing model passed to the local Vibe Code session via --model
# (ADR-0006: prefer a different family than the developer agent).
# Empty = the CLI's active model.
REVIEWER_MODEL=

# Optional hard cap on the reviewer session's total tokens (--max-tokens).
# Empty = uncapped (the session is already bounded by --max-turns and
# --time-limit).
REVIEWER_MAX_TOKENS=
